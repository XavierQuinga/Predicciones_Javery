# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA PREDICTIVO DE DIAGNÓSTICO DE FALLAS EN TI (JAVERY)
# ==============================================================================

# Entorno y Servidor
PROJECT_NAME="Sistema Predictivo de Diagnóstico de Fallas en Equipos Informáticos"
VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Base de Datos Central PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=diagnostico_ti
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=prefer

# Cadena de conexión completa opcional (útil para Azure Database for PostgreSQL Flexible Server)
# DATABASE_URL=postgresql://usuario:contrasena@servidor.postgres.database.azure.com:5432/diagnostico_ti?sslmode=require

# Fallback seguro para desarrollo local (permite ejecución inmediata sin docker si es true)
ALLOW_SQLITE_FALLBACK=true
SQLITE_DB_PATH=backend/diagnostico_local.db

# Rutas de Archivos del Modelo
MODEL_PATH=03_MODELO/mejor_modelo_diagnostico_fallas.joblib
METADATA_PATH=backend/ml/metadata.json

# Integración Power BI
# URL del informe publicado en Power BI Service / Web
POWERBI_DASHBOARD_URL=https://app.powerbi.com
